{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Relative imports name the TypeScript file they actually resolve to
    // (`./server.ts`), and the emitter rewrites each specifier to `./server.js`
    // on the way into dist/. Source stays readable as TypeScript; the published
    // tarball keeps the explicit extensions Node's ESM resolver requires.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "exactOptionalPropertyTypes": true,
    "incremental": false,
    "outDir": "dist",
    "rootDir": ".",
    // The Effect language service (@effect/tsgo, patched into `tsc` by the
    // `prepare` script) reports Effect diagnostics during `typecheck`.
    // Suggestions fail it as well, so a new one is fixed when it appears.
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectSuggestionsInTscExitCode": false,
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": { "diagnosticSeverity": { "floatingEffect": "error" } }
          },
          {
            // Scripts and tests run on Effect's file system, path, HTTP
            // client, Bun runtime, and @effect/vitest, which Effect marks
            // unstable. src/ ships to users and keeps the default, so it
            // cannot come to depend on an unstable API unnoticed.
            "include": ["scripts/**/*.ts", "test/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/FileSystem",
                "effect/Path",
                "effect/http",
                "@effect/platform-bun",
                "@effect/vitest"
              ]
            }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
