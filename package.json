{
  "name": "@setluca/mcp",
  "version": "0.3.0",
  "private": false,
  "description": "Let your AI assistant help with Luca conversations, leads, replies, campaigns, and bookings.",
  "keywords": [
    "ai",
    "luca",
    "mcp",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/setluca/luca-mcp.git"
  },
  "bin": {
    "luca-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./remote": "./dist/remote.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun src/index.ts",
    "inspect": "bun run build && bunx mcp-inspector --transport stdio bun dist/index.js",
    "inspect:cli": "bun run build && bunx mcp-inspector --cli --transport stdio bun dist/index.js",
    "test": "TZ=UTC vitest run --exclude test/stdio-smoke.test.ts",
    "test:mutation": "TZ=UTC stryker run",
    "test:stdio": "vitest run test/stdio-smoke.test.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:anti-slop": "oxlint . --deny-warnings",
    "format": "oxfmt --write . --disable-nested-config",
    "format:check": "oxfmt --check . --disable-nested-config",
    "knip": "knip",
    "fallow:dead-code": "fallow dead-code --fail-on-issues",
    "fallow:dupes": "fallow dupes --fail-on-issues --summary",
    "fallow:security": "fallow security --fail-on-issues --summary",
    "fallow:health:gate": "fallow health --min-score 85 --summary",
    "quality": "bun run format:check && bun run lint && bun run knip && bun run fallow:dead-code && bun run fallow:dupes && bun run fallow:security && bun run fallow:health:gate",
    "dev:remote": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "deploy:dry-run": "wrangler deploy --env production --dry-run",
    "test:integration": "vitest run test/integration",
    "coverage": "bun run test -- --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "bun run quality && bun run docs:check && bun run catalog:check && bun run openapi:inputs:check && bun run openapi:outputs:check && bun run openapi:check && bun run registry:check && bun run typecheck && bun run coverage && bun run build && bun run test:stdio && bun run contracts:deployed:check",
    "openapi:generate": "bun run catalog:generate && bun scripts/generate-openapi-inputs.ts --write && bun scripts/generate-openapi-outputs.ts --write",
    "contracts:sync": "bun scripts/contract-sync.ts",
    "contracts:deployed:check": "bun scripts/check-deployed-luca-contracts.ts",
    "catalog:generate": "bun scripts/generate-route-catalog.ts --write",
    "catalog:check": "bun scripts/generate-route-catalog.ts --check",
    "openapi:inputs:check": "bun scripts/generate-openapi-inputs.ts --check",
    "openapi:outputs:check": "bun scripts/generate-openapi-outputs.ts --check",
    "openapi:check": "bun scripts/check-openapi.ts",
    "registry:check": "bun scripts/check-registry.ts",
    "docs:generate": "bun scripts/generate-docs.ts --write",
    "docs:check": "bun scripts/generate-docs.ts --check",
    "clean": "rm -rf .turbo dist coverage node_modules"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/inspector": "^2.5.0",
    "@mpsuesser/oxlint-plugin-effect": "0.6.0",
    "@oxlint/plugins": "1.82.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "fallow": "3.23.0",
    "knip": "6.34.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0",
    "vitest": "^5.0.0",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": ">=20"
  },
  "//publish": "Publish name is @setluca/mcp (the @setluca npm org). To publish: tag mcp-v*. The workflow authenticates to npm with OIDC Trusted Publishing, so there is no NPM_TOKEN. See docs/release.md.",
  "mcpName": "io.github.setluca/luca-mcp"
}
